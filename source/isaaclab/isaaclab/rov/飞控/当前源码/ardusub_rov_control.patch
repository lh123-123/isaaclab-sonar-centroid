diff --git a/ArduSub/ROV_DepthHold.h b/ArduSub/ROV_DepthHold.h
new file mode 100644
--- /dev/null
+++ b/ArduSub/ROV_DepthHold.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Release-reference latch only; native pressure/velocity/acceleration PID owns outputs.
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace ROV_DepthHold {
+struct Output {
+    float altitude_cm = 0;  // Up-positive relative to the native EKF origin
+    bool hold = false;
+    bool captured = false;
+    bool valid = false;
+};
+class Target {
+public:
+    void reset() { _out = Output{}; _moving = false; _reset_seen = false; _reset_ms = 0; }
+    const Output &output() const { return _out; }
+    Output update(float measured_up_cm, float climb_rate_cms,
+                  bool pilot_released, uint32_t reset_ms, float reset_down_m) {
+        if (!std::isfinite(measured_up_cm) || !std::isfinite(climb_rate_cms) ||
+            !std::isfinite(reset_down_m)) { reset(); return _out; }
+        // Shift ONLY an existing reference before capturing a same-tick release.
+        // A positive Down-frame origin shift is a negative Up-centimeter shift.
+        if (_reset_seen && reset_ms != 0 && reset_ms != _reset_ms && _out.valid) {
+            _out.altitude_cm -= reset_down_m * 100.0f;
+            if (!std::isfinite(_out.altitude_cm)) { reset(); return _out; }
+        }
+        _reset_seen = true;
+        _reset_ms = reset_ms;
+        _out.captured = false;
+        // THR_DZ can make climb_rate zero while the trigger is still
+        // physically pressed. Coast with the native zero-velocity trajectory
+        // until the actual neutral edge, then capture that tick's depth.
+        if (!pilot_released || ::fabsf(climb_rate_cms) >= 0.05f) {
+            _moving = true;
+            _out.hold = false;
+            _out.valid = true;
+            return _out;
+        }
+        if (_moving || !_out.valid) {
+            _out.altitude_cm = measured_up_cm;
+            _out.captured = true;
+        }
+        _moving = false;
+        _out.hold = _out.valid = true;
+        return _out;
+    }
+    void limit_target(float minimum_up_cm, float maximum_up_cm) {
+        if (!_out.hold || !std::isfinite(minimum_up_cm) ||
+            !std::isfinite(maximum_up_cm) || minimum_up_cm > maximum_up_cm) { return; }
+        _out.altitude_cm = ::fmaxf(minimum_up_cm, ::fminf(maximum_up_cm, _out.altitude_cm));
+    }
+private:
+    Output _out;
+    bool _moving = false;
+    bool _reset_seen = false;
+    uint32_t _reset_ms = 0;
+};
+} // namespace ROV_DepthHold
diff --git a/ArduSub/ROV_PilotControl.cpp b/ArduSub/ROV_PilotControl.cpp
new file mode 100644
--- /dev/null
+++ b/ArduSub/ROV_PilotControl.cpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "Sub.h"
+
+void Sub::rov_pilot_enter() {
+    const bool preserve = control_mode == Mode::Number::STABILIZE || control_mode == Mode::Number::ALT_HOLD;
+    g2.rov_pilot.enter(preserve, degrees(ahrs.get_roll_rad()), degrees(ahrs.get_pitch_rad()), degrees(ahrs.get_yaw_rad()));
+}
+
+bool Sub::rov_pilot_input_fresh() const {
+    if (!g2.rov_pilot.enabled()) { return true; }
+    bool failed = failsafe.pilot_input || failsafe.gcs;
+#if AP_SUB_RC_ENABLED
+    failed = failed || failsafe.radio;
+#endif
+    return g2.rov_pilot.pilot_fresh(AP_HAL::millis(), failsafe.last_pilot_input_ms,
+                                  failed);
+}
+
+bool Sub::rov_pilot_attitude(float roll_cd, float pitch_cd) {
+    ROV_PilotKernel::Output out;
+    // Reuse ArduSub's angle mapping/circular limit, including ALT_HOLD's
+    // dynamically permitted tilt, rather than bypassing its depth constraints.
+    const float angle_limit = attitude_control.lean_angle_max_cd() * 0.01f;
+    const bool valid = g2.rov_pilot.update(G_Dt, degrees(ahrs.get_roll_rad()),
+        degrees(ahrs.get_pitch_rad()), degrees(ahrs.get_yaw_rad()),
+        roll_cd * 0.01f / angle_limit,
+        pitch_cd * 0.01f / angle_limit,
+        channel_yaw->get_control_in() / float(ROLL_PITCH_INPUT_MAX),
+        rov_pilot_input_fresh(), angle_limit, out);
+    if (!valid) { return false; }
+    attitude_control.input_euler_angle_roll_pitch_yaw_cd(out.roll * 100.0f, out.pitch * 100.0f, out.yaw * 100.0f, true);
+    last_pilot_heading_rad = radians(out.yaw);
+    return true;
+}
diff --git a/ArduSub/ROV_PilotHold.cpp b/ArduSub/ROV_PilotHold.cpp
new file mode 100644
