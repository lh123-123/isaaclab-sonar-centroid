new file mode 100644
--- /dev/null
+++ b/libraries/AP_Motors/ROV_AttitudeAllocation.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cmath>
+#include <cstddef>
+
+namespace ROV_AttitudeAllocation {
+struct Result { float rotation_scale; float translation_scale; bool valid; };
+// Allocate each disjoint Vectored-6DOF plane independently. Preserve the
+// requested rotational wrench first, then uniformly scale its translation.
+inline Result allocate(float *rotation, const float *translation,
+                       const bool *enabled, std::size_t count, float envelope = 1.0f) {
+    if (!std::isfinite(envelope) || envelope < 0.0f || envelope > 1.0f) {
+        return {0, 0, false};
+    }
+    float maximum = 0.0f;
+    for (std::size_t i = 0; i < count; ++i) {
+        if (!enabled[i]) { continue; }
+        if (!std::isfinite(rotation[i]) || !std::isfinite(translation[i])) {
+            return {0, 0, false};
+        }
+        maximum = ::fmaxf(maximum, ::fabsf(rotation[i]));
+    }
+    const float rotation_scale = maximum > envelope && maximum > 0.0f ? envelope / maximum : 1.0f;
+    float translation_scale = 1.0f;
+    for (std::size_t i = 0; i < count; ++i) {
+        if (!enabled[i]) { continue; }
+        rotation[i] *= rotation_scale;
+        const float linear = translation[i];
+        if (linear > 0) {
+            translation_scale = ::fminf(translation_scale, (envelope - rotation[i]) / linear);
+        } else if (linear < 0) {
+            translation_scale = ::fminf(translation_scale, (-envelope - rotation[i]) / linear);
+        }
+    }
+    translation_scale = ::fmaxf(0.0f, ::fminf(1.0f, translation_scale));
+    for (std::size_t i = 0; i < count; ++i) {
+        if (enabled[i]) { rotation[i] += translation[i] * translation_scale; }
+    }
+    return {rotation_scale, translation_scale, true};
+}
+} // namespace ROV_AttitudeAllocation
diff --git a/libraries/AP_Motors/ROV_AttitudeLimit.h b/libraries/AP_Motors/ROV_AttitudeLimit.h
new file mode 100644
--- /dev/null
+++ b/libraries/AP_Motors/ROV_AttitudeLimit.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cmath>
+#include <cstddef>
+
+namespace ROV_AttitudeLimit {
+struct Result { float scale; bool valid; };
+
+// Uniformly scale the combined roll/pitch contribution so its direction is
+// retained while no enabled vertical thruster receives more than `limit`.
+inline Result cap(float *rotation, const bool *enabled, std::size_t count,
+                  float limit) {
+    if (!std::isfinite(limit) || limit < 0.0f || limit > 1.0f) {
+        return {0.0f, false};
+    }
+    float maximum = 0.0f;
+    for (std::size_t i = 0; i < count; ++i) {
+        if (!enabled[i]) { continue; }
+        if (!std::isfinite(rotation[i])) { return {0.0f, false}; }
+        maximum = ::fmaxf(maximum, ::fabsf(rotation[i]));
+    }
+    const float scale = maximum > limit && maximum > 0.0f ? limit / maximum : 1.0f;
+    for (std::size_t i = 0; i < count; ++i) {
+        if (enabled[i]) { rotation[i] *= scale; }
+    }
+    return {scale, true};
+}
+} // namespace ROV_AttitudeLimit
diff --git a/libraries/AP_Motors/ROV_DeadzonePWM.h b/libraries/AP_Motors/ROV_DeadzonePWM.h
new file mode 100644
--- /dev/null
+++ b/libraries/AP_Motors/ROV_DeadzonePWM.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Stateless post-mix mapping; used only by normal ArduSub motor outputs.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace ROV_DeadzonePWM {
+
+inline int16_t calculate(float thrust, int16_t minimum, int16_t maximum,
+                         int16_t offset_us, float input_deadband)
+{
+    constexpr int16_t neutral = 1500;
+    if (!std::isfinite(thrust) || minimum >= neutral || maximum <= neutral) {
+        return neutral;
+    }
+    thrust = thrust < -1.0f ? -1.0f : thrust > 1.0f ? 1.0f : thrust;
+    const int16_t span = thrust > 0.0f ? maximum - neutral : neutral - minimum;
+    // Disabled means the stock conversion, without a new input deadband.
+    if (offset_us <= 0) {
+        return static_cast<int16_t>(neutral + thrust * span);
+    }
+    if (!std::isfinite(input_deadband) || input_deadband < 0.0f || input_deadband > 0.1f) {
+        return neutral;
+    }
+    const float magnitude = ::fabsf(thrust);
+    if (magnitude <= input_deadband) {
+        return neutral;
+    }
+    // Guard malformed parameter values. Never extend configured endpoints.
+    int16_t offset = offset_us > 100 ? 100 : offset_us;
+    offset = offset > span ? span : offset;
+    const float progress = (magnitude - input_deadband) / (1.0f - input_deadband);
+    // Reserve the offset inside the available span: no early saturation.
+    int16_t excursion = static_cast<int16_t>(::lroundf(offset + (span - offset) * progress));
+    excursion = excursion > span ? span : excursion;
+    return thrust > 0.0f ? neutral + excursion : neutral - excursion;
+}
+
+} // namespace ROV_DeadzonePWM
