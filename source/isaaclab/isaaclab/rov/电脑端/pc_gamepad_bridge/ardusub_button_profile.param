# Mission Planner格式备用；QGC请导入同名.params文件
# 实体推进器编号为左上1/右上2、左下3/右下4、内左上5/右上6、左下7/右下8。
# 标准Vectored_6DOF图左右相反，因此交换四对输出功能以保留实体编号和现有插头位置。
# X/Y模式与十字键云台由PC处理，对应飞控按钮设0避免重复执行。
# A=解锁、B=上锁仍由飞控处理；其他比赛按键由PC桥接本地处理。
# AUX1～3设Disabled后，PC用DO_SET_SERVO直接发送500～2500us目标。
# 这样慢速运动不再随MANUAL_CONTROL帧率重复，RB也可做真正两端切换。
SERVO1_FUNCTION,34
MOT_PWM_MIN,1000
MOT_PWM_MAX,2000
JS_GAIN_DEFAULT,1
JS_THR_GAIN,1
MOT_1_DIRECTION,1
